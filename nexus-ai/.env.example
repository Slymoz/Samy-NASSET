# Copy to .env and adjust: start.sh loads it (variables already set win).
# Every setting is optional; the values below are the defaults.

# --- Models (Ollama) ---
NEXUS_OLLAMA_URL=http://127.0.0.1:11434
NEXUS_CHAT_MODEL=llama3.2:1b
NEXUS_EMBED_MODEL=nomic-embed-text
# Seconds to wait for Ollama between two tokens (also for embeddings).
NEXUS_LLM_TIMEOUT=300
# Sampling temperature; leave empty to use the model default.
NEXUS_TEMPERATURE=

# --- Conversation ---
# Number of previous messages sent back to the model on each turn.
NEXUS_HISTORY_MESSAGES=20

# --- RAG ---
NEXUS_CHUNK_SIZE=900
NEXUS_CHUNK_OVERLAP=150
NEXUS_TOP_K=4
# Ignore passages farther than this cosine distance (empty = keep all).
NEXUS_MAX_DISTANCE=
NEXUS_EMBED_BATCH_SIZE=32
NEXUS_MAX_UPLOAD_MB=25

# --- Storage and network ---
# NEXUS_DATA_DIR=./data
NEXUS_HOST=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_UI_PORT=8501
NEXUS_MCP_PORT=8001
